@page
@model Intermediario.Pages.Productos.CrearModel

@{
    ViewData["Title"] = "Publicar producto";
}

<style>
    .publish-page {
        max-width: 850px;
        margin: 35px auto;
        padding: 30px;
        color: #f5f5f5;
        background: #111;
        border: 1px solid #292929;
        border-radius: 18px;
    }

    .publish-heading h2 {
        margin-bottom: 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .publish-heading p {
        margin-bottom: 28px;
        color: #aaa;
    }

    .publish-form .form-group {
        margin-bottom: 22px;
    }

    .publish-form label {
        display: block;
        margin-bottom: 9px;
        color: #eee;
        font-weight: 600;
    }

    .publish-form input:not([type="file"]),
    .publish-form textarea,
    .publish-form select {
        width: 100%;
        padding: 13px 15px;
        color: #fff;
        background: #1b1b1b;
        border: 1px solid #383838;
        border-radius: 9px;
        outline: none;
    }

        .publish-form input:focus,
        .publish-form textarea:focus,
        .publish-form select:focus {
            border-color: #39d98a;
        }

        .publish-form select option {
            color: #fff;
            background: #1b1b1b;
        }

    .image-upload-area {
        padding: 24px;
        text-align: center;
        background: #181818;
        border: 2px dashed #3a3a3a;
        border-radius: 13px;
    }

        .image-upload-area p {
            margin: 0 0 12px;
            color: #aaa;
        }

    .image-upload-button {
        display: inline-block;
        padding: 11px 19px;
        color: #07130c;
        background: #39d98a;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
    }

        .image-upload-button:hover {
            background: #26c879;
        }

    #Fotos {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
    }

    .image-help {
        display: block;
        margin-top: 12px;
        color: #888;
        font-size: 13px;
    }

    .image-preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(125px, 1fr));
        gap: 13px;
        margin-top: 20px;
    }

    .image-preview-item {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        background: #242424;
        border: 1px solid #383838;
        border-radius: 10px;
    }

        .image-preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .remove-image-button {
        position: absolute;
        top: 7px;
        right: 7px;
        width: 27px;
        height: 27px;
        color: #fff;
        background: #d93636;
        border: 0;
        border-radius: 50%;
        cursor: pointer;
        font-size: 17px;
        line-height: 1;
    }

    .image-count {
        margin-top: 12px;
        color: #39d98a;
        font-size: 13px;
    }

    .publish-validation {
        margin-bottom: 18px;
        color: #ff7777;
    }

    .publish-actions {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 25px;
    }

    .publish-button {
        padding: 13px 22px;
        color: #07130c;
        background: #39d98a;
        border: 0;
        border-radius: 9px;
        font-weight: 700;
        cursor: pointer;
    }

        .publish-button:hover {
            background: #26c879;
        }

    .publish-cancel {
        color: #aaa;
        text-decoration: none;
    }

        .publish-cancel:hover {
            color: #fff;
        }

    @@media (max-width: 600px) {
        .publish-page {
            margin: 15px;
            padding: 20px;
        }

        .publish-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="publish-page">

    <div class="publish-heading">
        <h2>Publicar un producto</h2>
        <p>Completa la información y agrega fotografías para mostrar tu producto.</p>
    </div>

    <form method="post"
          enctype="multipart/form-data"
          class="publish-form">

        <div asp-validation-summary="ModelOnly"
             class="publish-validation">
        </div>

        <div class="form-group">
            <label asp-for="Producto.titulo">Nombre del producto</label>

            <input asp-for="Producto.titulo"
                   placeholder="Ej. Laptop Lenovo"
                   maxlength="150"
                   required />

            <span asp-validation-for="Producto.titulo"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.descripcion">Descripción</label>

            <textarea asp-for="Producto.descripcion"
                      placeholder="Describe el producto..."
                      rows="4"></textarea>

            <span asp-validation-for="Producto.descripcion"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.precio">Precio</label>

            <input asp-for="Producto.precio"
                   type="number"
                   step="0.01"
                   min="0.01"
                   placeholder="0.00"
                   required />

            <span asp-validation-for="Producto.precio"></span>
        </div>

        <div class="form-group">
            <label asp-for="Producto.VendedorId">Vendedor</label>

            <select asp-for="Producto.VendedorId"
                    asp-items="Model.Vendedores"
                    required>

                <option value="">Selecciona un vendedor</option>

            </select>

            <span asp-validation-for="Producto.VendedorId"></span>
        </div>

        <div class="form-group">

            <label>Fotografías del producto</label>

            <div class="image-upload-area">

                <p>
                    Agrega fotografías para que los compradores conozcan tu producto.
                </p>

                <label for="Fotos" class="image-upload-button">
                    + Seleccionar imágenes
                </label>

                <input type="file"
                       id="Fotos"
                       name="Fotos"
                       accept="image/jpeg,image/png,image/webp"
                       multiple />

                <span class="image-help">
                    Puedes seleccionar hasta 5 imágenes en formato JPG, PNG o WEBP.
                    Máximo 5 MB por imagen.
                </span>

                <div id="imagePreview" class="image-preview-grid"></div>

                <div id="imageCount" class="image-count">
                    0 de 5 imágenes seleccionadas
                </div>

            </div>
        </div>

        <div class="publish-actions">

            <button type="submit" class="publish-button">
                Publicar producto
            </button>

            <a asp-page="/Index" class="publish-cancel">
                Cancelar
            </a>

        </div>

    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const inputFotos = document.getElementById("Fotos");
        const preview = document.getElementById("imagePreview");
        const contador = document.getElementById("imageCount");

        let archivosSeleccionados = [];

        inputFotos.addEventListener("change", function () {

            const nuevosArchivos = Array.from(inputFotos.files);

            const permitidos = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            for (const archivo of nuevosArchivos) {

                if (!permitidos.includes(archivo.type)) {
                    alert("Solo puedes seleccionar imágenes JPG, PNG o WEBP.");
                    continue;
                }

                if (archivosSeleccionados.length >= 5) {
                    alert("Solo puedes agregar un máximo de 5 imágenes.");
                    break;
                }

                if (archivo.size > 5 * 1024 * 1024) {
                    alert("Cada imagen debe pesar máximo 5 MB.");
                    continue;
                }

                archivosSeleccionados.push(archivo);
            }

            actualizarVistaPrevia();
        });

        function actualizarVistaPrevia() {

            preview.innerHTML = "";

            const transferencia = new DataTransfer();

            archivosSeleccionados.forEach((archivo, indice) => {

                transferencia.items.add(archivo);

                const url = URL.createObjectURL(archivo);

                const contenedor = document.createElement("div");
                contenedor.className = "image-preview-item";

                const imagen = document.createElement("img");
                imagen.src = url;
                imagen.alt = "Vista previa de " + archivo.name;

                const boton = document.createElement("button");
                boton.type = "button";
                boton.className = "remove-image-button";
                boton.textContent = "×";
                boton.setAttribute("aria-label", "Quitar imagen");

                boton.addEventListener("click", function () {

                    URL.revokeObjectURL(url);

                    archivosSeleccionados.splice(indice, 1);

                    actualizarVistaPrevia();
                });

                contenedor.appendChild(imagen);
                contenedor.appendChild(boton);

                preview.appendChild(contenedor);
            });

            inputFotos.files = transferencia.files;

            contador.textContent =
                archivosSeleccionados.length +
                " de 5 imágenes seleccionadas";
        }
    </script>
}
